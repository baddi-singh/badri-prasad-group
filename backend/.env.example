# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/BadriPrasadDB

# Server Port
PORT=5001

# JWT Secret (Required for authentication - Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Email Configuration (Gmail)
EMAIL_USER=contact@badriprasadgroup.com
EMAIL_PASS=your_hostinger_mailbox_password
NOTIFICATION_EMAIL=contact@badriprasadgroup.com

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# Cloudinary Configuration (For file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Node Environment
NODE_ENV=development

# Frontend URLs (for CORS)
FRONTEND_URL_DEV=http://localhost:5173
FRONTEND_URL_STAGING=https://test.badriprasadgroup.com
FRONTEND_URL_PROD=https://www.badriprasadgroup.com
